{
  "name": "@buddy-creator/assistant",
  "version": "0.2.2",
  "description": "Buddy creator skill with host-led interviews, durable local projects and live read-only preview",
  "type": "module",
  "bin": {
    "buddy": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin"
  ],
  "files": [
    "dist",
    "preview-dist",
    "rules",
    "integrations",
    "native",
    "README.md",
    "RELEASE_NOTES.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc && vite build",
    "dev": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "pack:skill": "npm run build && node scripts/pack-skill.mjs"
  },
  "dependencies": {
    "@langchain/langgraph": "1.4.13",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@mozilla/readability": "^0.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "fast-xml-parser": "^5.2.5",
    "fflate": "^0.8.2",
    "linkedom": "^0.18.12",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0",
    "xstate": "^5.23.0"
  }
}
