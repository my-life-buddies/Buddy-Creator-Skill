#!/bin/sh
set -eu
buddy_skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
buddy_node=$(command -v node || true)
if [ -z "$buddy_node" ]; then
  for buddy_candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$buddy_candidate" ]; then buddy_node=$buddy_candidate; break; fi
  done
fi
if [ -z "$buddy_node" ]; then
  printf '%s\n' '{"ok":false,"error":{"code":"NODE_REQUIRED","message":"Buddy 需要 Node.js 22.13 或更高版本；请在宿主允许的环境中准备后重试。"}}'
  exit 1
fi
exec "$buddy_node" "$buddy_skill_dir/scripts/buddy.mjs" "$@"
