#!/bin/sh
set -eu
buddy_skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
buddy_node=$(command -v node || true)
if [ -z "$buddy_node" ]; then
  for buddy_candidate in /opt/homebrew/bin/node /usr/local/bin/node; do
    if [ -x "$buddy_candidate" ]; then buddy_node=$buddy_candidate; break; fi
  done
fi
if [ -z "$buddy_node" ]; then
  printf '%s\n' '{"ok":false,"error":{"code":"NODE_REQUIRED","message":"Buddy 需要 Node.js 22.13 或更高版本；请在宿主允许的环境中准备后重试。"}}'
  exit 1
fi
"$buddy_node" -e 'const [major,minor]=process.versions.node.split(".").map(Number); if(major<22||(major===22&&minor<13)){process.stdout.write(JSON.stringify({ok:false,error:{code:"NODE_VERSION",message:"Buddy 需要 Node.js 22.13 或更高版本。"}})+"\n");process.exit(1)} if(process.platform!=="darwin"){process.stdout.write(JSON.stringify({ok:false,error:{code:"PLATFORM_UNSUPPORTED",message:"此版本支持 macOS。"}})+"\n");process.exit(1)}'
export BUDDY_SKILL_ENTRY="$buddy_skill_dir/scripts/buddy"
exec "$buddy_node" "$buddy_skill_dir/lib/dist/cli.js" "$@"
